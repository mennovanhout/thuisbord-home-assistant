{
  "entity": {
    "sensor": {
      "status": {
        "default": "mdi:transmission-tower-export",
        "state": {
          "retrying": "mdi:cloud-refresh-variant",
          "refused": "mdi:alert-circle-outline",
          "stopped": "mdi:key-alert-outline"
        }
      },
      "last_sent": {
        "default": "mdi:clock-check-outline"
      },
      "battery_advice": {
        "default": "mdi:battery-clock-outline",
        "state": {
          "charge": "mdi:battery-charging",
          "hold": "mdi:battery-lock",
          "normal": "mdi:battery-outline"
        }
      }
    },
    "binary_sensor": {
      "recommend_charge": {
        "default": "mdi:battery-off-outline",
        "state": {
          "on": "mdi:battery-charging-outline"
        }
      }
    }
  },
  "services": {
    "send_reading": {
      "service": "mdi:transmission-tower-export"
    }
  }
}
